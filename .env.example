# ZeroDaily Serving API Environment Configuration

# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=zerodaily-articles

# Local AWS Credentials (Optional if configured via ~/.aws/credentials or IAM Role)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins, or * for public access)
CORS_ORIGINS=*
