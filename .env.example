# ZeroDaily Serving API & Notification Configuration

# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=zerodaily-articles

# Local AWS Credentials (Optional if using ~/.aws/credentials or IAM Role)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Firebase Cloud Messaging (FCM HTTP v1)
# You can provide the JSON string, file path, or an AWS Secrets Manager secret name
FIREBASE_PROJECT_ID=zerodaily-prod
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SECRET_NAME=

# Notification Policy & Cooldown
NOTIFICATION_COOLDOWN_MINUTES=30
ENABLE_ALL_BREAKING_TOPIC=true

# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
